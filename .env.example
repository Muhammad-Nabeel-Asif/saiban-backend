# Node Environment
NODE_ENV=production

# Server Port
PORT=3000

# MongoDB Connection Strings
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/saiban-db
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/saiban-db
MONGODB_URI_STAGING=mongodb+srv://username:password@cluster.mongodb.net/saiban-db-staging

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=240h

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL (password reset links)
FRONTEND_URL=http://localhost:3000

# Password reset token lifetime (hours)
PASSWORD_RESET_EXPIRY_HOURS=1

# Forgot-password rate limits (optional overrides)
# FORGOT_PASSWORD_RATE_WINDOW_MS=900000
# FORGOT_PASSWORD_MAX_PER_EMAIL=3
# FORGOT_PASSWORD_MAX_PER_IP=10

# SMTP (optional — reset links are logged when unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@saiban.app
