# Node Environment
NODE_ENV=production

# Server Port
PORT=3000

# MongoDB Connection Strings
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/saiban-db
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/saiban-db
MONGODB_URI_STAGING=mongodb+srv://username:password@cluster.mongodb.net/saiban-db-staging

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=240h

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
